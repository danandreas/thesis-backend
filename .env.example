# Application
APP_NAME=Psychoposition
APP_ENV=development
APP_DEBUG=true
APP_PORT=5100
APP_SECRET_KEY=ganti-dengan-secret-key-yang-kuat

# Database
# MAMP (Mac): DB_PORT=8889
# XAMPP (Windows/Linux): DB_PORT=3306
DB_HOST=localhost
DB_PORT=8889
DB_DATABASE=thesis
DB_USERNAME=root
DB_PASSWORD=root

# JWT
JWT_SECRET_KEY=ganti-dengan-jwt-secret-yang-kuat
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# CORS - pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=storage/logs/app.log
